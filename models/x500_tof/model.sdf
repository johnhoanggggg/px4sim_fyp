        <pose relative_to="base_link">-0.077 0.238 0 0 0 1.8850</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/3</topic>
      </sensor>
    </link>
    <joint name="tof_3_joint" type="fixed"><parent>base_link</parent><child>tof_3_link</child></joint>

    <!-- Sensor 5: Forward-up 45 deg (was 144 deg horizontal) -->
    <link name="tof_4_link">
      <pose relative_to="base_link">0.15 0 0.05 0 -0.7854 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_4' type='gpu_lidar'>
        <gz_frame_id>tof_4_link</gz_frame_id>
        <pose relative_to="base_link">0.15 0 0.05 0 -0.7854 0</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/4</topic>
      </sensor>
    </link>
    <joint name="tof_4_joint" type="fixed"><parent>base_link</parent><child>tof_4_link</child></joint>

    <!-- Sensor 6: 180 deg (rear) -->
    <link name="tof_5_link">
      <pose relative_to="base_link">-0.250 0.000 0 0 0 3.1416</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_5' type='gpu_lidar'>
        <gz_frame_id>tof_5_link</gz_frame_id>
        <pose relative_to="base_link">-0.250 0.000 0 0 0 3.1416</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/5</topic>
      </sensor>
    </link>
    <joint name="tof_5_joint" type="fixed"><parent>base_link</parent><child>tof_5_link</child></joint>

    <!-- Sensor 7: Forward-down 45 deg (was 216 deg horizontal) -->
    <link name="tof_6_link">
      <pose relative_to="base_link">0.15 0 -0.05 0 0.7854 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_6' type='gpu_lidar'>
        <gz_frame_id>tof_6_link</gz_frame_id>
        <pose relative_to="base_link">0.15 0 -0.05 0 0.7854 0</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/6</topic>
      </sensor>
    </link>
    <joint name="tof_6_joint" type="fixed"><parent>base_link</parent><child>tof_6_link</child></joint>

    <!-- Sensor 8: 252 deg -->
    <link name="tof_7_link">
      <pose relative_to="base_link">-0.077 -0.238 0 0 0 -1.8850</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_7' type='gpu_lidar'>
        <gz_frame_id>tof_7_link</gz_frame_id>
        <pose relative_to="base_link">-0.077 -0.238 0 0 0 -1.8850</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/7</topic>
      </sensor>
    </link>
    <joint name="tof_7_joint" type="fixed"><parent>base_link</parent><child>tof_7_link</child></joint>

    <!-- Sensor 9: 288 deg -->
    <link name="tof_8_link">
      <pose relative_to="base_link">0.077 -0.238 0 0 0 -1.2566</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_8' type='gpu_lidar'>
        <gz_frame_id>tof_8_link</gz_frame_id>
        <pose relative_to="base_link">0.077 -0.238 0 0 0 -1.2566</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/8</topic>
      </sensor>
    </link>
    <joint name="tof_8_joint" type="fixed"><parent>base_link</parent><child>tof_8_link</child></joint>

    <!-- Sensor 10: 324 deg -->
    <link name="tof_9_link">
      <pose relative_to="base_link">0.202 -0.147 0 0 0 -0.6283</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_9' type='gpu_lidar'>
        <gz_frame_id>tof_9_link</gz_frame_id>
        <pose relative_to="base_link">0.202 -0.147 0 0 0 -0.6283</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/9</topic>
      </sensor>
    </link>
    <joint name="tof_9_joint" type="fixed"><parent>base_link</parent><child>tof_9_link</child></joint>

    <!-- Sensor 11: Up -->
    <link name="tof_up_link">
      <pose relative_to="base_link">0 0 0.05 0 -1.5708 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_up' type='gpu_lidar'>
        <gz_frame_id>tof_up_link</gz_frame_id>
        <pose relative_to="base_link">0 0 0.05 0 -1.5708 0</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/up</topic>
      </sensor>
    </link>
    <joint name="tof_up_joint" type="fixed"><parent>base_link</parent><child>tof_up_link</child></joint>

    <!-- Sensor 12: Down -->
    <link name="tof_down_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.5708 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_down' type='gpu_lidar'>
        <gz_frame_id>tof_down_link</gz_frame_id>
        <pose relative_to="base_link">0 0 -0.05 0 1.5708 0</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/down</topic>
      </sensor>
    </link>
    <joint name="tof_down_joint" type="fixed"><parent>base_link</parent><child>tof_down_link</child></joint>

    <!-- ===== OAK-D Lite Stereo Camera ===== -->
    <!-- Left camera: 7.5cm baseline, mounted front-centre, facing forward -->
    <!-- OAK-D Lite: 640x480, 73deg HFOV, 30fps, 7.5cm stereo baseline -->

    <link name="oakd_left_link">
      <pose relative_to="base_link">0.10 0.0375 -0.02 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="oakd_left" type="camera">
        <update_rate>30</update_rate>
        <camera name="oakd_left">
          <horizontal_fov>1.2741</horizontal_fov> <!-- 73 deg -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <lens>
            <intrinsics>
              <!-- fx = width / (2 * tan(hfov/2)) = 640 / (2 * tan(36.5deg)) = 432.0 -->
              <fx>432.0</fx>
              <fy>432.0</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/oakd/left/image_raw</topic>
      </sensor>
    </link>
    <joint name="oakd_left_joint" type="fixed"><parent>base_link</parent><child>oakd_left_link</child></joint>

    <!-- Right camera: offset -7.5cm in Y from left -->
    <link name="oakd_right_link">
      <pose relative_to="base_link">0.10 -0.0375 -0.02 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="oakd_right" type="camera">
        <update_rate>30</update_rate>
        <camera name="oakd_right">
          <horizontal_fov>1.2741</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>432.0</fx>
              <fy>432.0</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/oakd/right/image_raw</topic>
      </sensor>
    </link>
    <joint name="oakd_right_joint" type="fixed"><parent>base_link</parent><child>oakd_right_link</child></joint>

    <!-- OAK-D Lite onboard IMU (BMI270) -->
    <link name="oakd_imu_link">
      <pose relative_to="base_link">0.10 0 -0.02 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="oakd_imu" type="imu">
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.003</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <always_on>1</always_on>
        <topic>/oakd/imu</topic>
      </sensor>
    </link>
    <joint name="oakd_imu_joint" type="fixed"><parent>base_link</parent><child>oakd_imu_link</child></joint>

  </model>
</sdf>
