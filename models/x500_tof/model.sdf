<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_tof'>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Sensor 1: Front (0 deg) -->
    <link name="tof_0_link">
      <pose relative_to="base_link">0.250 0.000 0 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_0' type='gpu_lidar'>
        <gz_frame_id>tof_0_link</gz_frame_id>
        <pose relative_to="base_link">0.250 0.000 0 0 0 0</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/0</topic>
      </sensor>
    </link>
    <joint name="tof_0_joint" type="fixed"><parent>base_link</parent><child>tof_0_link</child></joint>

    <!-- Sensor 2: 36 deg -->
    <link name="tof_1_link">
      <pose relative_to="base_link">0.202 0.147 0 0 0 0.6283</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_1' type='gpu_lidar'>
        <gz_frame_id>tof_1_link</gz_frame_id>
        <pose relative_to="base_link">0.202 0.147 0 0 0 0.6283</pose>
        <update_rate>12</update_rate>
        <ray><scan><horizontal><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></horizontal><vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3927</min_angle><max_angle>0.3927</max_angle></vertical></scan><range><min>0.02</min><max>2.0</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise></ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/tof/1</topic>
      </sensor>
    </link>
    <joint name="tof_1_joint" type="fixed"><parent>base_link</parent><child>tof_1_link</child></joint>

    <!-- Sensor 3: 72 deg -->
    <link name="tof_2_link">
      <pose relative_to="base_link">0.077 0.238 0 0 0 1.2566</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name='tof_2' type='gpu_lidar'>
