#!/bin/sh
#
# @name Gazebo Propguards with ToF sensor
#
# @type Quadrotor
#

# Must be a hard assignment — CMake sets PX4_SIM_MODEL=gz_propguards_tof
# from the filename, so :=default won't override it
PX4_SIM_MODEL=propguards_tof

# Keep this line! It loads the base quadcopter flight dynamics and tuning
. ${R}etc/init.d-posix/airframes/4001_gz_x500
